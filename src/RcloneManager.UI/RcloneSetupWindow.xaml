<UserControl x:Class="RcloneManager.UI.RcloneSetupWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="500">
    <StackPanel Margin="20">
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Preparando o Rclone Automaticamente" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock x:Name="TargetInfoText" Text="Versão: v1.76.0" FontSize="12.5"
                       Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="ReasonText" Text="Verificando arquivos locais..." FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <ProgressBar x:Name="DownloadProgressBar" Height="16" Minimum="0" Maximum="100" Value="0"
                             Background="#0B1220" Foreground="#2563EB" BorderBrush="#334155" BorderThickness="1"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StageDetailText" Grid.Column="0" Text="Iniciando..." FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Text="" Foreground="#EF4444" FontSize="11.5"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RetryButton" Content="Tentar Novamente" Style="{StaticResource PrimaryButtonStyle}"
                    Click="RetryButton_Click" IsEnabled="False" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="Cancelar" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
