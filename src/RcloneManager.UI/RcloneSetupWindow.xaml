<Window x:Class="RcloneManager.UI.RcloneSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preparando Rclone (Release Travada)"
        Width="520" Height="270"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindowBrush}"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Provisionamento Automático do Rclone" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock x:Name="TargetInfoText" Text="Release travada: v1.76.0" FontSize="12.5"
                       Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="ReasonText" Text="Verificando binário local..." FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <ProgressBar x:Name="DownloadProgressBar" Height="16" Minimum="0" Maximum="100" Value="0"
                             Background="#0B1220" Foreground="#2563EB" BorderBrush="#334155" BorderThickness="1"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StageDetailText" Grid.Column="0" Text="Iniciando..." FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Text="" Foreground="#EF4444" FontSize="11.5"
                   TextWrapping="Wrap" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RetryButton" Content="Tentar Novamente" Style="{StaticResource PrimaryButtonStyle}"
                    Click="RetryButton_Click" IsEnabled="False" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="Cancelar" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
