<UserControl x:Class="RcloneManager.UI.ResetConfigWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520">
    <StackPanel Margin="20">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Resetar ou Limpar Configurações" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="✕" Padding="8,3" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextMutedBrush}" Click="CancelButton_Click" ToolTip="Fechar"/>
        </Grid>

        <TextBlock Text="Escolha o que deseja apagar. As configurações locais serão reinicializadas automaticamente."
                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <CheckBox IsChecked="True" IsEnabled="False"
                          Content="Resetar configurações e tarefas do RcloneManager"
                          Margin="0,0,0,10"/>

                <CheckBox x:Name="DeleteLogsRuntimeCheck" IsChecked="True"
                          Content="Remover histórico de logs e arquivos temporários"
                          Margin="0,0,0,10"/>

                <CheckBox x:Name="DeleteRcloneConfCheck" IsChecked="False"
                          Content="Apagar também as contas conectadas na nuvem (cria backup .bak antes)"
                          Foreground="#FCA5A5" Margin="0,0,0,12"/>

                <Separator Background="#334155" Margin="0,0,0,10"/>

                <CheckBox x:Name="ReopenWizardCheck" IsChecked="True"
                          Content="Abrir o Assistente Inicial automaticamente após o reset"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="CancelButton_Click" Margin="0,0,8,0"/>
            <Button Content="Confirmar Reset" Style="{StaticResource DangerButtonStyle}" Click="ConfirmButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
