<Window x:Class="RcloneManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RcloneManager — Controle Híbrido, Interface &amp; Serviço"
        Height="800" Width="1180"
        MinHeight="640" MinWidth="960"
        Background="{StaticResource BgWindowBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE MENU CLÁSSICA -->
        <Menu Grid.Row="0">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="Nova Tarefa" InputGestureText="Ctrl+N" Click="MenuNewJob_Click"/>
                <MenuItem Header="Salvar Alterações da Aba Atual" InputGestureText="Ctrl+S" Click="MenuSaveCurrent_Click"/>
                <Separator/>
                <MenuItem Header="Abrir Pasta de Trabalho" Click="MenuOpenWorkspace_Click"/>
                <MenuItem Header="Abrir rclone_manager_config.json" Click="MenuOpenConfigFile_Click"/>
                <MenuItem Header="Abrir Pasta de Logs" Click="MenuOpenLogsFolder_Click"/>
                <Separator/>
                <MenuItem Header="Exportar Configuração..." Click="MenuExportConfig_Click"/>
                <MenuItem Header="Importar Configuração..." Click="MenuImportConfig_Click"/>
                <Separator/>
                <MenuItem Header="Executar Assistente Inicial (Wizard)..." Click="MenuRunWizard_Click"/>
                <MenuItem Header="Resetar / Deletar Configurações..." Click="MenuResetConfig_Click"/>
                <Separator/>
                <MenuItem Header="Ao clicar no [X] da janela">
                    <MenuItem x:Name="MenuCloseAskItem" Header="Perguntar sempre" Click="MenuCloseAsk_Click"/>
                    <MenuItem x:Name="MenuCloseTrayItem" Header="Minimizar para a Bandeja" Click="MenuCloseTray_Click"/>
                    <MenuItem x:Name="MenuCloseExitUiItem" Header="Fechar Janela (manter 2º plano)" Click="MenuCloseExitUi_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Minimizar para a Bandeja" Click="MenuMinimizeToTray_Click"/>
                <MenuItem Header="Fechar Interface (Manter Serviço)" Click="MenuCloseUiOnly_Click"/>
                <MenuItem Header="Sair (Encerrar Interface + Serviço)" Click="MenuExitAll_Click"/>
            </MenuItem>
            <MenuItem Header="Aj_uda">
                <MenuItem Header="Abrir Documentação Local (docs/)" Click="MenuOpenDocs_Click"/>
                <MenuItem Header="Repositório no GitHub" Click="MenuOpenGitHub_Click"/>
                <MenuItem Header="Documentação Oficial do Rclone" Click="MenuOpenRcloneDocs_Click"/>
                <Separator/>
                <MenuItem Header="Verificar Atualizações do Aplicativo..." Click="MenuCheckAppUpdate_Click"/>
                <MenuItem Header="Verificar Release Travada do Rclone" Click="MenuCheckRelease_Click"/>
                <MenuItem Header="Copiar Informações de Diagnóstico" Click="MenuCopyDiagnostics_Click"/>
                <Separator/>
                <MenuItem Header="Sobre o RcloneManager..." Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="RcloneManager" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Background="#1D4ED8" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BACKUP &amp; NUVEM" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="RcloneVersionText" Text="rclone ..." Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="ServiceStatusDot" Width="10" Height="10" Fill="#F59E0B" Margin="0,0,7,0"/>
                        <TextBlock x:Name="ServiceStatusText" Text="Conectando ao serviço em 2º plano..." FontSize="12.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,18,0"/>
                        <TextBlock x:Name="RcdStatusText" Text="Daemon RC: verificando..." FontSize="12.5"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateReadyButton" Content="✦ Atualização pronta" Visibility="Collapsed"
                            Style="{StaticResource PrimaryButtonStyle}" Click="UpdateReadyButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ToggleRcdButton" Content="Alternar Daemon RC" Click="ToggleRcdButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="QuickRunPrimaryButton" Content="▶ Executar Backup Principal"
                            Style="{StaticResource SuccessButtonStyle}" Click="QuickRunPrimaryButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABS -->
        <TabControl x:Name="MainTabs" Grid.Row="1">
            <!-- ABA 1: DASHBOARD -->
            <TabItem x:Name="DashboardTab" Header="Dashboard &amp; Ao Vivo">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- KPIs -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="TAREFA ATIVA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="ActiveJobTitleText" Text="Nenhuma em execução" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ActiveStrategyText" Text="Aguardando próximo agendamento" FontSize="11.5"
                                           Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="4,0,8,0">
                            <StackPanel>
                                <TextBlock Text="VELOCIDADE &amp; PROGRESSO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="SpeedValueText" Text="0 B/s" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,2"/>
                                <TextBlock x:Name="ProgressValueText" Text="0% (0 B / 0 B)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="4,0,8,0">
                            <StackPanel>
                                <TextBlock Text="ARQUIVOS &amp; ERROS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TransfersValueText" Text="0 / 0 transf." FontSize="17" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,2"/>
                                <TextBlock x:Name="ErrorsEtaText" Text="Erros: 0 | ETA: --" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="REMOTES &amp; ARMAZENAMENTO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="RemotesListText" Text="Carregando..." FontSize="14" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                <TextBlock x:Name="DriveAboutText" Text="Espaço: clique Atualizar" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PROGRESSO + CONTROLE DE BANDA -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Progresso da Transferência em Tempo Real"
                                           FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ProgressBar x:Name="OverallProgressBar" Height="16" Minimum="0" Maximum="100" Value="0"
                                             Background="#0B1220" Foreground="#2563EB" BorderBrush="#334155" BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="Velocidade:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="BwLimitCombo" Width="125" Margin="0,0,6,0">
                                    <ComboBoxItem Content="Sem limite" Tag="off"/>
                                    <ComboBoxItem Content="1 MB/s" Tag="1M"/>
                                    <ComboBoxItem Content="2 MB/s" Tag="2M"/>
                                    <ComboBoxItem Content="5 MB/s" Tag="5M"/>
                                    <ComboBoxItem Content="10 MB/s" Tag="10M"/>
                                    <ComboBoxItem Content="20 MB/s" Tag="20M"/>
                                    <ComboBoxItem Content="50 MB/s" Tag="50M"/>
                                </ComboBox>
                                <Button x:Name="ApplyBwButton" Content="Aplicar" Click="ApplyBwButton_Click" Margin="0,0,8,0"/>
                                <Button x:Name="RefreshRemotesButton" Content="Atualizar Remotes" Click="RefreshRemotesButton_Click" Margin="0,0,8,0"/>
                                <Button x:Name="StopActiveButton" Content="■ Parar Tarefa" Style="{StaticResource DangerButtonStyle}"
                                        Click="StopActiveButton_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ARQUIVOS SENDO TRANSFERIDOS -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Arquivos em Transferência Agora" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid x:Name="TransferringGrid" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="*"/>
                                    <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeFormatted}" Width="100"/>
                                    <DataGridTextColumn Header="Enviado" Binding="{Binding TransferredFormatted}" Width="100"/>
                                    <DataGridTextColumn Header="%" Binding="{Binding PercentText}" Width="70"/>
                                    <DataGridTextColumn Header="Velocidade" Binding="{Binding SpeedFormatted}" Width="110"/>
                                    <DataGridTextColumn Header="ETA" Binding="{Binding EtaFormatted}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ABA 2: TAREFAS & AGENDADOR -->
            <TabItem x:Name="JobsTab" Header="Tarefas &amp; Agendador">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LISTA DE TAREFAS -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Tarefas Configuradas" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                                <Button x:Name="NewJobButton" Content="+ Nova Tarefa" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="NewJobButton_Click" Margin="0,0,6,6"/>
                                <Button x:Name="RunSelectedJobButton" Content="▶ Executar" Style="{StaticResource SuccessButtonStyle}"
                                        Click="RunSelectedJobButton_Click" Margin="0,0,6,6"/>
                                <Button x:Name="DryRunSelectedJobButton" Content="Testar (Simular)"
                                        Click="DryRunSelectedJobButton_Click" Margin="0,0,6,6"/>
                                <Button x:Name="StopSelectedJobButton" Content="■ Parar" Style="{StaticResource DangerButtonStyle}"
                                        Click="StopSelectedJobButton_Click" Margin="0,0,6,6"/>
                                <Button x:Name="DeleteSelectedJobButton" Content="Excluir"
                                        Click="DeleteSelectedJobButton_Click" Margin="0,0,0,6"/>
                            </WrapPanel>

                            <DataGrid x:Name="JobsGrid" Grid.Row="2" SelectionChanged="JobsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="95"/>
                                    <DataGridTextColumn Header="Próx. Execução" Binding="{Binding NextRunText}" Width="120"/>
                                    <DataGridTextColumn Header="Última" Binding="{Binding LastRunText}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- EDITOR SIMPLIFICADO DE TAREFA + AGENDADOR -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Configurar Tarefa" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Escolha o que copiar, para onde enviar e quando executar."
                                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="JobEnabledCheck" Grid.Column="1" Content="Tarefa ativa"
                                              FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 1. NOME E MODO -->
                                <TextBlock Text="Nome da Tarefa" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="JobNameBox" Margin="0,0,0,12"/>

                                <TextBlock Text="O que você deseja fazer?" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox x:Name="JobOperationCombo" SelectionChanged="JobOperationCombo_SelectionChanged"/>
                                <TextBlock x:Name="JobOperationHintText"
                                           Text="Mantém o destino idêntico à pasta de origem."
                                           FontSize="11.5" Foreground="{StaticResource AccentCyanBrush}"
                                           TextWrapping="Wrap" Margin="2,4,0,12"/>

                                <!-- 2. ORIGEM E DESTINO -->
                                <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Pastas de Origem e Destino" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8"/>

                                        <TextBlock Text="De onde copiar (pasta neste computador)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <Grid Margin="0,3,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="JobSourceBox"/>
                                            <Button x:Name="BrowseSourceButton" Grid.Column="1" Content="Escolher..." Margin="6,0,0,0" Click="BrowseSourceButton_Click"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1.3*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Onde salvar" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="JobDestTargetCombo" SelectionChanged="JobDestTargetCombo_SelectionChanged"/>
                                                    <Button x:Name="RefreshDestRemotesButton" Grid.Column="1" Content="↻" Padding="9,5" Margin="5,0,0,0"
                                                            ToolTip="Atualizar lista de serviços na nuvem" Click="RefreshDestRemotesButton_Click"/>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="JobDestSubfolderLabel" Text="Pasta dentro da nuvem (ex: MeusBackups)"
                                                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="JobDestBox" TextChanged="JobDestBox_TextChanged"/>
                                                    <Button x:Name="BrowseDestFolderButton" Grid.Column="1" Content="Escolher..."
                                                            Visibility="Collapsed" Margin="6,0,0,0" Click="BrowseDestFolderButton_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="JobDestPreviewText" Text="" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. QUANDO EXECUTAR (AGENDAMENTO SIMPLIFICADO) -->
                                <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Quando executar" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>

                                        <ComboBox x:Name="JobScheduleModeCombo" SelectionChanged="JobScheduleModeCombo_SelectionChanged"/>

                                        <!-- Opção: Repetir em intervalo -->
                                        <Grid x:Name="ScheduleIntervalPanel" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Repetir a cada" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                                <ComboBox x:Name="JobIntervalPresetCombo" SelectionChanged="JobIntervalPresetCombo_SelectionChanged"/>
                                            </StackPanel>
                                            <StackPanel x:Name="CustomIntervalPanel" Grid.Column="1" Width="115" Margin="10,0,0,0" Visibility="Collapsed">
                                                <TextBlock Text="Minutos" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                                <TextBox x:Name="JobIntervalBox"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Opção: Horário fixo (Diário ou Semanal) -->
                                        <StackPanel x:Name="ScheduleTimePanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Horário do dia (HH:mm):" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0"/>
                                            <TextBox x:Name="JobDailyTimeBox" Width="90" Text="14:00"/>
                                        </StackPanel>

                                        <!-- Opção: Dias da semana -->
                                        <StackPanel x:Name="ScheduleDaysPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Escolha os dias da semana:" FontSize="11.5"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                            <WrapPanel>
                                                <CheckBox x:Name="DayMonCheck" Content="Seg" Margin="0,0,12,4"/>
                                                <CheckBox x:Name="DayTueCheck" Content="Ter" Margin="0,0,12,4"/>
                                                <CheckBox x:Name="DayWedCheck" Content="Qua" Margin="0,0,12,4"/>
                                                <CheckBox x:Name="DayThuCheck" Content="Qui" Margin="0,0,12,4"/>
                                                <CheckBox x:Name="DayFriCheck" Content="Sex" Margin="0,0,12,4"/>
                                                <CheckBox x:Name="DaySatCheck" Content="Sáb" Margin="0,0,12,4"/>
                                                <CheckBox x:Name="DaySunCheck" Content="Dom" Margin="0,0,0,4"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <CheckBox x:Name="JobRetryCheck" Content="Tentar novamente sozinho se a internet oscilar"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4. OPÇÕES ADICIONAIS E AVANÇADAS (RECOLHIDO POR PADRÃO) -->
                                <Expander x:Name="JobAdvancedExpander"
                                          Header="Opções adicionais (limites, pastas ignoradas e avançado)"
                                          IsExpanded="False"
                                          Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Ignorar arquivos maiores que" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                                <ComboBox x:Name="JobMaxSizePresetCombo" SelectionChanged="JobMaxSizePresetCombo_SelectionChanged"/>
                                                <TextBox x:Name="JobMaxSizeBox" Margin="0,5,0,0" Visibility="Collapsed" ToolTip="Ex: 50M, 500M, 2G"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Limitar uso da internet nesta tarefa" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                                <ComboBox x:Name="JobBwPresetCombo" SelectionChanged="JobBwPresetCombo_SelectionChanged"/>
                                                <TextBox x:Name="JobBwLimitBox" Margin="0,5,0,0" Visibility="Collapsed" ToolTip="Ex: 2M, 10M"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Lista de pastas/arquivos ignorados (opcional)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <Grid Margin="0,3,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="JobFilterPathBox"/>
                                            <Button x:Name="BrowseFilterButton" Grid.Column="1" Content="Escolher..." Margin="6,0,0,0" Click="BrowseFilterButton_Click"/>
                                            <Button x:Name="OpenFilterInEditorButton" Grid.Column="2" Content="Editar Lista" Margin="6,0,0,0" Click="OpenFilterInEditorButton_Click"/>
                                        </Grid>

                                        <WrapPanel Margin="0,0,0,10">
                                            <CheckBox x:Name="JobSkipLinksCheck" Content="Ignorar atalhos do sistema" Margin="0,0,16,6"/>
                                            <CheckBox x:Name="JobFastListCheck" Content="Acelerar leitura de pastas na nuvem" Margin="0,0,16,6"/>
                                            <CheckBox x:Name="JobCopyLinksCheck" Content="Copiar destino original de atalhos" Margin="0,0,16,6"/>
                                            <CheckBox x:Name="JobDryRunCheck" Content="Modo teste (apenas simular, sem alterar arquivos)" Margin="0,0,0,6"/>
                                        </WrapPanel>

                                        <Expander Header="Ajustes técnicos (uso avançado)" Background="#111827" IsExpanded="False">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Modo de execução" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                        <ComboBox x:Name="JobStrategyCombo"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Interpretação da lista de ignorados" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                        <ComboBox x:Name="JobFilterModeCombo"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Máx. tentativas" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                        <TextBox x:Name="JobMaxRetriesBox"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Espera (min)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                        <TextBox x:Name="JobRetryDelayBox"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Arquivo de registro (log)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                        <TextBox x:Name="JobLogFileBox"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Parâmetros extras do Rclone (opcional)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                <TextBox x:Name="JobExtraFlagsBox"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Expander>

                                <Button x:Name="SaveJobButton" Content="Salvar Tarefa"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="38" Click="SaveJobButton_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ABA 3: REMOTES (rclone.conf) -->
            <TabItem x:Name="RemotesTab" Header="Remotes (rclone.conf)">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LISTA DE REMOTES -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Remotes Configurados (rclone.conf)" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="RemoteConfigPathText" Grid.Row="1" Text="Arquivo: detectando..." FontSize="11.5"
                                       Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                            <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                                <Button x:Name="NewRemoteButton" Content="+ Novo Remote" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="NewRemoteButton_Click" Margin="0,0,6,6"/>
                                <Button x:Name="TestRemoteButton" Content="Testar Conexão" Style="{StaticResource SuccessButtonStyle}"
                                        Click="TestRemoteButton_Click" Margin="0,0,6,6"/>
                                <Button x:Name="ReconnectRemoteButton" Content="Reautenticar (OAuth)"
                                        Click="ReconnectRemoteButton_Click" Margin="0,0,6,6"/>
                                <Button x:Name="DeleteRemoteButton" Content="Excluir" Style="{StaticResource DangerButtonStyle}"
                                        Click="DeleteRemoteButton_Click" Margin="0,0,6,6"/>
                                <Button x:Name="RefreshRemotesTabButton" Content="Atualizar"
                                        Click="RefreshRemotesTabButton_Click" Margin="0,0,6,6"/>
                                <Button x:Name="OpenTerminalConfigButton" Content="Terminal rclone config"
                                        Click="OpenTerminalConfigButton_Click" Margin="0,0,0,6"/>
                            </WrapPanel>

                            <DataGrid x:Name="RemotesGrid" Grid.Row="3" SelectionChanged="RemotesGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="1.1*"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="80"/>
                                    <DataGridTextColumn Header="Autenticação" Binding="{Binding AuthText}" Width="105"/>
                                    <DataGridTextColumn Header="Parâmetros" Binding="{Binding ParamsSummary}" Width="1.3*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="4" Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                <TextBlock x:Name="RemoteTestResultText" Text="Selecione um remote para testar conexão ou editar parâmetros."
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ASSISTENTE VISUAL DE CONFIGURAÇÃO -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock x:Name="RemoteEditorTitleText" Text="Criar Novo Remote" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nome do Remote (sem ':')" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBox x:Name="RemoteNameBox" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Filtrar Provedor" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBox x:Name="ProviderSearchBox" Margin="0,2,0,0" TextChanged="ProviderSearchBox_TextChanged"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Provedor / Backend (71+ suportados pelo Rclone)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="RemoteProviderCombo" Margin="0,2,0,8" SelectionChanged="RemoteProviderCombo_SelectionChanged"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Modo de Autenticação" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <ComboBox x:Name="RemoteAuthModeCombo" Margin="0,2,0,0" SelectionChanged="RemoteAuthModeCombo_SelectionChanged">
                                            <ComboBoxItem Content="Via Link (Navegador / OAuth)" Tag="OAuthBrowserLink" IsSelected="True"/>
                                            <ComboBoxItem Content="Via Token JSON Manual" Tag="ManualTokenJson"/>
                                            <ComboBoxItem Content="Via Chave / Credenciais (Key, Senha ou Service Account)" Tag="KeyOrCredentials"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox x:Name="RemoteShowAdvancedCheck" Grid.Column="2" Content="Avançadas"
                                              VerticalAlignment="Bottom" Margin="0,0,0,6" Click="RemoteShowAdvancedCheck_Click"/>
                                </Grid>

                                <Border x:Name="DriveClientIdHintBorder" Visibility="Collapsed" Background="#0B1220" BorderBrush="#F59E0B"
                                        BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="11" Foreground="#FDE68A" TextWrapping="Wrap" Margin="0,0,8,0"
                                                   Text="Google Drive: o client_id compartilhado do Rclone está sendo descontinuado em 2026. Recomenda-se preencher client_id + client_secret próprios abaixo."/>
                                        <Button Grid.Column="1" Content="Guia Oficial" Padding="8,4" VerticalAlignment="Center"
                                                Click="OpenDriveClientIdGuide_Click"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="ManualTokenPanel" Visibility="Collapsed" Margin="0,4,0,2">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Cole o Token JSON (gerado com rclone authorize)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <Button Content="Gerar Token via rclone authorize" HorizontalAlignment="Right" Padding="8,3"
                                                Click="GenerateTokenViaAuthorize_Click"/>
                                    </Grid>
                                    <TextBox x:Name="RemoteManualTokenBox" AcceptsReturn="True" Height="64" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="1" Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                <TextBlock x:Name="RemoteProviderDescText" Text="Selecione um provedor para carregar as opções oficiais do Rclone."
                                           FontSize="11.5" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="RemoteOptionsPanel" Margin="0,0,8,0"/>
                            </ScrollViewer>

                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock x:Name="RemoteSaveStatusText" Text="" FontSize="11.5" Foreground="#F59E0B" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <Button x:Name="SaveRemoteButton" Content="Salvar Remote (via Rclone)"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="36" Click="SaveRemoteButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ABA 4: FILTROS & OTIMIZADOR -->
            <TabItem x:Name="FiltersTab" Header="Filtros &amp; Otimizador">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Arquivo:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="FilterFilePathBox" Grid.Column="1" Text="exclude_user_folder.txt"/>
                                <Button x:Name="BrowseEditorFilterButton" Grid.Column="2" Content="Procurar" Margin="6,0,0,0" Click="BrowseEditorFilterButton_Click"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="AnalyzeFilterButton" Content="Carregar / Analisar" Click="AnalyzeFilterButton_Click" Margin="0,0,6,0"/>
                                <Button x:Name="OptimizeFilterButton" Content="Corrigir &amp; Otimizar (Backup .bak)"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="OptimizeFilterButton_Click" Margin="0,0,6,0"/>
                                <Button x:Name="SaveFilterButton" Content="Salvar Edição" Style="{StaticResource SuccessButtonStyle}"
                                        Click="SaveFilterButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="FilterStatusBadge" Grid.Row="1" Background="#1E293B" BorderBrush="#F59E0B"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBox x:Name="FilterDiagnosticsText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                 Text="Clique em 'Carregar / Analisar' para inspecionar seu arquivo de filtros."/>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                        <TextBox x:Name="FilterEditorBox" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Consolas" FontSize="12.5"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ABA 5: LOGS & SERVIÇO -->
            <TabItem x:Name="LogsTab" Header="Logs &amp; Serviço">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gerenciamento do Serviço em Segundo Plano" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <CheckBox x:Name="WindowsStartupCheck" Content="Iniciar automaticamente com o Windows"
                                              Click="WindowsStartupCheck_Click" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="AutoUpdateAppCheck" Content="Atualizar aplicativo automaticamente em 2º plano"
                                              IsChecked="True" Click="AutoUpdateAppCheck_Click" Margin="0,0,18,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                        <TextBlock Text="Ao fechar a janela [X]:" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="CloseBehaviorCombo" Width="225" SelectionChanged="CloseBehaviorCombo_SelectionChanged"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ServiceAdminStatusText" Text="Serviço local ativo na porta 5580"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,6"/>
                                    <TextBlock x:Name="VaultStatusText" Text="Proteção local: verificando..."
                                               Foreground="#10B981" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ReconnectServiceButton" Content="Iniciar / Reconectar Serviço"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="ReconnectServiceButton_Click" Margin="0,0,6,0"/>
                                <Button x:Name="ShutdownServiceButton" Content="Encerrar Serviço"
                                        Style="{StaticResource DangerButtonStyle}" Click="ShutdownServiceButton_Click" Margin="0,0,6,0"/>
                                <Button Content="Assistente (Wizard)" Click="MenuRunWizard_Click" Margin="0,0,6,0"/>
                                <Button Content="Resetar Configs" Style="{StaticResource DangerButtonStyle}" Click="MenuResetConfig_Click" Margin="0,0,6,0"/>
                                <Button x:Name="InstallWindowsServiceButton" Content="Instalar WinService"
                                        Click="InstallWindowsServiceButton_Click" Margin="0,0,6,0"/>
                                <Button x:Name="UninstallWindowsServiceButton" Content="Remover WinService"
                                        Click="UninstallWindowsServiceButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Release do Rclone (Auto-Download &amp; Trava de Versão)" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Text="Versão Travada:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="PinnedVersionBox" Width="110" Text="v1.76.0" Margin="0,0,14,0"/>
                                    <CheckBox x:Name="LockVersionCheck" Content="Travar nesta release (baixar automaticamente se ausente ou divergente)"
                                              IsChecked="True" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <TextBlock x:Name="ReleaseStatusText" Text="Status da release: verificando..."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button x:Name="ApplyPinnedReleaseButton" Grid.Column="1" Content="Baixar / Travar Release"
                                    Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"
                                    Click="ApplyPinnedReleaseButton_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fonte do Log:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="LogSourceCombo" Width="230" SelectionChanged="LogControls_Changed" Margin="0,0,14,0">
                                <ComboBoxItem Content="Rclone (rclone_backup.log)" IsSelected="True"/>
                                <ComboBoxItem Content="Serviço &amp; Agendador"/>
                            </ComboBox>

                            <TextBlock Text="Filtro:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="LogFilterCombo" Width="170" SelectionChanged="LogControls_Changed" Margin="0,0,14,0">
                                <ComboBoxItem Content="Todos os registros" IsSelected="True"/>
                                <ComboBoxItem Content="Apenas Erros (ERROR)"/>
                                <ComboBoxItem Content="Avisos e Erros"/>
                            </ComboBox>

                            <CheckBox x:Name="AutoScrollLogsCheck" Content="Rolagem automática" IsChecked="True" Margin="0,0,14,0"/>
                            <Button x:Name="RefreshLogsButton" Content="Atualizar Logs" Click="RefreshLogsButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
                        <TextBox x:Name="LogsTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <TextBlock x:Name="FooterInfoText" Grid.Row="2" Margin="2,8,2,0" FontSize="11.5"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="Pronto. O serviço em segundo plano substitui script.bat e rodar.vbs mantendo o agendador ativo mesmo com a janela fechada."/>
        </Grid>

        <!-- CAMADA INTEGRADA DE PAINÉIS E DIÁLOGOS INTERNOS (SEM NOVA JANELA) -->
        <Grid x:Name="OverlayContainer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"/>
    </Grid>
</Window>
