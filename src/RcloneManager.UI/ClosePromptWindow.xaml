<UserControl x:Class="RcloneManager.UI.ClosePromptWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="470">
    <StackPanel Margin="20">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Como deseja fechar?" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="✕" Padding="8,3" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextMutedBrush}" Click="CancelButton_Click" ToolTip="Voltar"/>
        </Grid>

        <TextBlock Text="Seus backups agendados continuarão funcionando normalmente em segundo plano nas duas opções."
                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="• Minimizar para a Bandeja: mantém o ícone perto do relógio para reabrir rápido."
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Text="• Fechar Janela: encerra apenas esta tela e mantém o serviço ativo em 2º plano."
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Separator Background="#334155" Margin="0,0,0,10"/>

                <CheckBox x:Name="RememberChoiceCheck"
                          Content="Lembrar minha escolha e não perguntar novamente"
                          FontWeight="SemiBold"/>
                <TextBlock Text="Você pode mudar isso quando quiser no menu Arquivo ou na aba Logs &amp; Serviço."
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="22,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid>
            <Button Content="Voltar" HorizontalAlignment="Left" Click="CancelButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fechar Janela" Click="CloseUiOnlyButton_Click" Margin="0,0,8,0"/>
                <Button Content="Minimizar para a Bandeja" Style="{StaticResource PrimaryButtonStyle}"
                        Click="MinimizeToTrayButton_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
