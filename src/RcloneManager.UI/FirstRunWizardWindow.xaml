<UserControl x:Class="RcloneManager.UI.FirstRunWizardWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="750"
             Height="585">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Assistente de Configuração Inicial" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Conclua cada etapa na ordem abaixo para deixar seus backups prontos para uso."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="DismissWizardButton" Grid.Column="1" Content="✕" Padding="8,3" VerticalAlignment="Top"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextMutedBrush}" Click="DismissWizardButton_Click" ToolTip="Fechar"/>
        </Grid>

        <!-- INDICADOR DE ETAPAS -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Step1Badge" Grid.Column="0" Background="#2563EB" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                <TextBlock x:Name="Step1BadgeText" Text="1. Como Começar" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
            <Border x:Name="Step2Badge" Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                <TextBlock x:Name="Step2BadgeText" Text="2. Preparar Rclone" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
            <Border x:Name="Step3Badge" Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                <TextBlock x:Name="Step3BadgeText" Text="3. Conectar Destino" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
            <Border x:Name="Step4Badge" Grid.Column="3" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,6">
                <TextBlock x:Name="Step4BadgeText" Text="4. Revisar &amp; Concluir" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- CORPO DAS ETAPAS -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <Grid>
                <!-- ETAPA 1: ESCOLHER ENTRE COMEÇAR DO ZERO OU IMPORTAR -->
                <StackPanel x:Name="Step1Panel" Visibility="Visible">
                    <TextBlock Text="Como você deseja configurar este computador?" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Selecione uma das duas opções abaixo para liberar a próxima etapa:"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"/>

                    <!-- OPÇÃO A: COMEÇAR DO ZERO -->
                    <Border x:Name="StartScratchCard"
                            Background="#0B1220" BorderBrush="#334155" BorderThickness="2" CornerRadius="8"
                            Padding="14" Margin="0,0,0,12" Cursor="Hand"
                            MouseLeftButtonDown="StartScratchCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Começar do zero" FontWeight="Bold" FontSize="14.5" Foreground="#F8FAFC"/>
                                    <Border x:Name="ScratchSelectedPill" Visibility="Collapsed" Background="#059669" CornerRadius="4" Padding="7,2" Margin="10,0,0,0">
                                        <TextBlock Text="✓ Selecionado" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Ideal para uma nova instalação. Vamos preparar o Rclone, conectar sua conta na nuvem (ou pasta local) e criar sua tarefa de backup passo a passo."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="SelectScratchButton" Grid.Column="1" Content="Começar do Zero"
                                    VerticalAlignment="Center" Click="SelectScratchButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- OPÇÃO B: IMPORTAR CONFIGURAÇÃO -->
                    <Border x:Name="StartImportCard"
                            Background="#0B1220" BorderBrush="#334155" BorderThickness="2" CornerRadius="8"
                            Padding="14" Margin="0,0,0,14" Cursor="Hand"
                            MouseLeftButtonDown="StartImportCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Importar configuração existente (.json)" FontWeight="Bold" FontSize="14.5" Foreground="#F8FAFC"/>
                                    <Border x:Name="ImportSelectedPill" Visibility="Collapsed" Background="#2563EB" CornerRadius="4" Padding="7,2" Margin="10,0,0,0">
                                        <TextBlock x:Name="ImportSelectedPillText" Text="Escolher arquivo" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="WizardImportSummaryText"
                                           Text="Já usa o RcloneManager em outro PC? Carregue seu arquivo exportado (.json) para trazer todas as suas tarefas prontas e apenas validar suas contas."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button x:Name="WizardImportConfigButton" Grid.Column="1" Content="Escolher Arquivo..."
                                    VerticalAlignment="Center" Click="WizardImportConfigButton_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Nota de segurança: senhas e tokens nunca ficam expostos em arquivos exportados; a proteção local é feita automaticamente pelo aplicativo."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ETAPA 2: PREPARAR RCLONE -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="Preparar o Rclone neste computador" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="O aplicativo verifica se o Rclone está instalado e íntegro antes de liberar a conexão com suas contas."
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Versão Recomendada" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox x:Name="WizardPinnedVersionBox" Text="v1.76.0" Margin="0,3,0,0"
                                     TextChanged="WizardReleaseField_Changed"/>
                        </StackPanel>
                        <CheckBox x:Name="WizardLockVersionCheck" Grid.Column="1" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                  Click="WizardLockVersionCheck_Click"
                                  Content="Manter fixo nesta versão (baixa automaticamente se não estiver instalado)"/>
                    </Grid>

                    <Border x:Name="WizardReleaseStatusBorder" Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                        <TextBlock x:Name="WizardReleaseStatusText" Text="Verificando instalação do Rclone..." FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <Button x:Name="WizardVerifyReleaseButton" Content="Baixar / Verificar Rclone Agora"
                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"
                            Click="WizardVerifyReleaseButton_Click"/>
                </StackPanel>

                <!-- ETAPA 3: CONECTAR E VALIDAR PROVEDOR SELECIONADO -->
                <ScrollViewer x:Name="Step3Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Conectar e Validar Serviço de Destino" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Selecione o provedor onde deseja guardar seus backups e conclua a conexão para liberar a próxima etapa."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- LISTA DE CONTAS QUANDO VEIO DE IMPORTAÇÃO -->
                        <StackPanel x:Name="WizardImportedRemotesPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBlock Text="Contas apontadas na configuração importada (clique em cada pendente e conecte):" FontSize="11.5"
                                       Foreground="#FDE68A" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ListBox x:Name="WizardImportedRemotesList" MaxHeight="84"
                                     Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#334155"
                                     SelectionChanged="WizardImportedRemotesList_SelectionChanged"/>
                        </StackPanel>

                        <!-- SELETOR DE PROVEDOR + APELIDO -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition x:Name="RemoteAliasColumn" Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Provedor / Onde guardar" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                <ComboBox x:Name="WizardProviderCombo" Margin="0,3,0,0" SelectionChanged="WizardProviderCombo_SelectionChanged">
                                    <ComboBoxItem Content="Google Drive" Tag="drive" IsSelected="True"/>
                                    <ComboBoxItem Content="Microsoft OneDrive" Tag="onedrive"/>
                                    <ComboBoxItem Content="Dropbox" Tag="dropbox"/>
                                    <ComboBoxItem Content="Amazon S3 / Cloudflare R2 / MinIO" Tag="s3"/>
                                    <ComboBoxItem Content="Servidor SSH / SFTP" Tag="sftp"/>
                                    <ComboBoxItem Content="Servidor FTP" Tag="ftp"/>
                                    <ComboBoxItem Content="Pasta na Rede Windows (SMB)" Tag="smb"/>
                                    <ComboBoxItem Content="WebDAV / Nextcloud" Tag="webdav"/>
                                    <ComboBoxItem Content="Disco / Pasta Local ou HD Externo" Tag="local"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="RemoteAliasPanel" Grid.Column="2">
                                <TextBlock Text="Apelido desta conta" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="WizardRemoteNameBox" Text="gdrive" Margin="0,3,0,0"
                                         TextChanged="WizardRemoteNameBox_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- SELETOR DE MODO DE LOGIN (APENAS PROVEDORES OAUTH) -->
                        <StackPanel x:Name="WizardAuthModeSection" Margin="0,0,0,8">
                            <TextBlock Text="Método de conexão" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                            <ComboBox x:Name="WizardAuthModeCombo" Margin="0,3,0,0" SelectionChanged="WizardAuthModeCombo_SelectionChanged"/>
                        </StackPanel>

                        <!-- ORIENTAÇÃO ESPECÍFICA DO PROVEDOR -->
                        <Border x:Name="WizardProviderGuideBorder" Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,8">
                            <TextBlock x:Name="WizardProviderGuideText"
                                       Text="Ao clicar em 'Conectar Google Drive', o navegador será aberto para login. O assistente aguardará a conclusão e testará o acesso à conta."
                                       FontSize="11.5" Foreground="#38BDF8" TextWrapping="Wrap"/>
                        </Border>

                        <!-- OPÇÃO ESPECÍFICA: PASTA LOCAL / HD EXTERNO -->
                        <StackPanel x:Name="WizardLocalFolderPanel" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock Text="Escolha a pasta de destino neste computador ou HD externo *" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WizardLocalDestFolderBox" TextChanged="WizardLocalDestFolderBox_TextChanged"/>
                                <Button Grid.Column="1" Content="Escolher Pasta..." Margin="6,0,0,0" Click="WizardBrowseLocalDest_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- OPÇÃO ESPECÍFICA: OAUTH CLIENT ID (OPCIONAL P/ DRIVE/ONEDRIVE/DROPBOX) -->
                        <Expander x:Name="WizardOAuthAdvancedExpander" Header="Credenciais OAuth personalizadas (Client ID próprio — opcional)"
                                  IsExpanded="False" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Client ID" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox x:Name="WizardClientIdBox" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Client Secret" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox x:Name="WizardClientSecretBox" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <!-- OPÇÃO ESPECÍFICA: TOKEN MANUAL -->
                        <StackPanel x:Name="WizardTokenPanel" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Cole o Token JSON de autorização *" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <Button Content="Gerar pelo terminal" HorizontalAlignment="Right" Padding="8,3"
                                        Click="WizardAuthorizeTerminal_Click"/>
                            </Grid>
                            <TextBox x:Name="WizardTokenBox" AcceptsReturn="True" Height="58" FontFamily="Consolas" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- OPÇÃO ESPECÍFICA: ARQUIVO DE CHAVE / SERVICE ACCOUNT -->
                        <StackPanel x:Name="WizardKeyFileSection" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock x:Name="WizardKeyFileLabel" Text="Arquivo de Chave / Credencial" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WizardKeyFileBox"/>
                                <Button Grid.Column="1" Content="Escolher..." Margin="6,0,0,0" Click="WizardBrowseKeyFile_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- OPÇÃO ESPECÍFICA: SERVIDOR / CREDENCIAIS (S3, SFTP, FTP, SMB, WEBDAV) -->
                        <Grid x:Name="WizardServerCredsGrid" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="WizardHostFieldPanel" Grid.Column="0">
                                <TextBlock x:Name="WizardHostLabel" Text="Servidor / Endpoint *" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="WizardHostBox" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="WizardUserFieldPanel" Grid.Column="2">
                                <TextBlock x:Name="WizardUserLabel" Text="Usuário / Access Key *" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="WizardUserBox" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="WizardPassFieldPanel" Grid.Column="4">
                                <TextBlock x:Name="WizardPassLabel" Text="Senha / Secret Key *" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <PasswordBox x:Name="WizardPassBox" Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Padding="6,5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- PAINEL DE ESPERA EM TEMPO REAL DURANTE LOGIN / TESTE -->
                        <Border x:Name="WizardWaitingBanner" Visibility="Collapsed"
                                Background="#0B1220" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,2,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock x:Name="WizardWaitingText" Text="Aguardando autorização no navegador..."
                                               FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                                    <ProgressBar IsIndeterminate="True" Height="8" Margin="0,6,0,0"
                                                 Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Cancelar Espera" Style="{StaticResource DangerButtonStyle}"
                                        VerticalAlignment="Center" Padding="10,5" Click="CancelAuthWaitButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- BOTÃO DE AÇÃO + RESULTADO DA VALIDAÇÃO -->
                        <WrapPanel VerticalAlignment="Center" Margin="0,4,0,4">
                            <Button x:Name="WizardCreateRemoteButton" Content="Conectar &amp; Validar Google Drive"
                                    Style="{StaticResource SuccessButtonStyle}" Click="WizardCreateRemoteButton_Click" Margin="0,0,8,4"/>
                            <Button x:Name="WizardTestExistingButton" Content="Validar Conta Já Salva"
                                    Visibility="Collapsed" Click="WizardTestExistingButton_Click" Margin="0,0,10,4"/>
                        </WrapPanel>

                        <Border x:Name="WizardConnectionStatusBorder" Background="#0B1220" BorderBrush="#334155"
                                BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,2,0,0">
                            <TextBlock x:Name="WizardRemoteActionText"
                                       Text="Nenhuma conta validada nesta etapa ainda."
                                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ETAPA 4: REVISÃO DAS TAREFAS & CONCLUIR -->
                <Grid x:Name="Step4Panel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="115"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Revisar Tarefas de Backup" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Confira os caminhos de origem e destino de suas tarefas antes de finalizar."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11.5"/>
                    </StackPanel>

                    <ListBox x:Name="WizardJobsReviewList" Grid.Row="1" Background="#0B1220" Foreground="#F8FAFC"
                             BorderBrush="#334155" Margin="0,0,0,10" SelectionChanged="WizardJobsReviewList_SelectionChanged"/>

                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nome da Tarefa" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="WizardJobNameBox" TextChanged="WizardJobField_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ação" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="WizardJobOpCombo" SelectionChanged="WizardJobOpCombo_SelectionChanged"/>
                            </StackPanel>
                            <CheckBox x:Name="WizardJobEnabledCheck" Grid.Column="4" Content="Tarefa ativa"
                                      Click="WizardJobEnabledCheck_Click" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                        </Grid>

                        <TextBlock Text="De onde copiar (pasta neste computador)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WizardSourceBox" TextChanged="WizardJobField_TextChanged"/>
                            <Button Grid.Column="1" Content="Escolher..." Margin="6,0,0,0" Click="WizardBrowseSource_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Onde salvar (ex: gdrive:MeusBackups/ ou pasta local)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="WizardDestBox" TextChanged="WizardJobField_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Repetir a cada (min)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="WizardIntervalBox" Text="120" TextChanged="WizardJobField_TextChanged"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="Atualizar Lista" VerticalAlignment="Bottom"
                                    Click="WizardApplyJobEdit_Click"/>
                        </Grid>
                    </StackPanel>

                    <CheckBox x:Name="WizardAutoStartupCheck" Grid.Row="3" IsChecked="True"
                              Content="Iniciar serviço de agendamento automaticamente junto com o Windows"/>
                </Grid>
            </Grid>
        </Border>

        <!-- RODAPÉ NAVEGAÇÃO COM BLOQUEIO SEQUENCIAL -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StepGateHintText" Grid.Column="0"
                       Text="Escolha uma das opções acima para continuar."
                       FontSize="11.5" Foreground="#F59E0B"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="◀ Voltar" Click="BackButton_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="NextButton" Content="Avançar ▶" Style="{StaticResource PrimaryButtonStyle}"
                        Click="NextButton_Click" IsEnabled="False" Width="145"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
