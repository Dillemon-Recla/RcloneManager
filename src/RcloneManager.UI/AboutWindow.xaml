<UserControl x:Class="RcloneManager.UI.AboutWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="610"
             MaxHeight="580">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/icon-256x256.png" Width="36" Height="36"
                               Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="RcloneManager" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Border Background="#2563EB" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AppVersionText" Text="v1.0.0" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <Border Background="#059669" CornerRadius="4" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MIT LICENSE" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Padding="8,3" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextMutedBrush}" Click="CloseButton_Click" ToolTip="Fechar"/>
                </Grid>

                <TextBlock Text="Gerenciador visual de backups e sincronização em nuvem para Windows, com agendador automático em segundo plano, acompanhamento em tempo real e proteção de versão do Rclone."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,4"/>
                <TextBlock Text="Copyright © 2026 Dillemon Recla" FontSize="11.5" Foreground="#38BDF8"/>
            </StackPanel>
        </Border>

        <!-- AMBIENTE EM EXECUÇÃO -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12,10">
            <StackPanel>
                <TextBlock Text="AMBIENTE EM EXECUÇÃO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="RuntimeInfoText" Text="Runtime: .NET 10" FontSize="12" Margin="0,0,0,2"/>
                <TextBlock x:Name="OsInfoText" Text="Sistema: Windows" FontSize="12" Margin="0,0,0,2"/>
                <TextBlock x:Name="RcloneInfoText" Text="Rclone: verificando..." FontSize="12" Foreground="#38BDF8"/>
            </StackPanel>
        </Border>

        <!-- PACOTES, FRAMEWORKS E TECNOLOGIAS -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="TECNOLOGIAS &amp; COMPONENTES UTILIZADOS" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Rclone (rclone.exe) — Licença MIT" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="Motor oficial de sincronização e armazenamento em nuvem com verificação automática SHA-256."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text=".NET 10, ASP.NET Core &amp; WPF — Licença MIT" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="Interface gráfica nativa para Windows e serviço local em segundo plano, sem dependências externas de terceiros."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- APOIE O PROJETO -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="4" Padding="4" Width="88" Height="88" Margin="0,0,14,0">
                    <Image Source="pack://application:,,,/Assets/pix-qrcode.png" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="APOIE O PROJETO (OPEN SOURCE)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                    <TextBlock Text="Chave Pix (Aleatória):" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="95b9aa86-3c99-421d-9c86-6a47a3b09d7b" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,2,0,6"/>
                    <WrapPanel VerticalAlignment="Center">
                        <Button x:Name="CopyPixButton" Content="Copiar Chave Pix" Style="{StaticResource SuccessButtonStyle}"
                                Click="CopyPixButton_Click" Padding="10,5" Margin="0,0,8,4"/>
                        <Button x:Name="OpenSponsorsButton" Content="GitHub Sponsors" Style="{StaticResource PrimaryButtonStyle}"
                                Click="OpenSponsorsButton_Click" Padding="10,5" Margin="0,0,8,4"/>
                        <Button x:Name="OpenKofiButton" Content="Ko-fi"
                                Click="OpenKofiButton_Click" Padding="10,5" Margin="0,0,10,4"/>
                        <TextBlock x:Name="CopiedPixText" Text="" FontSize="11.5" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RODAPÉ -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="OpenLicenseButton" Content="Ver Licença (MIT)" Click="OpenLicenseButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="OpenGitHubButton" Content="Repositório GitHub" Click="OpenGitHubButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="OpenRcloneSiteButton" Content="Site do Rclone" Click="OpenRcloneSiteButton_Click"/>
            </StackPanel>
            <Button Content="Fechar" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"
                    Width="95" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</UserControl>
