<Window x:Class="RcloneManager.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre o RcloneManager"
        Width="620" Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgWindowBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RcloneManager" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Border Background="#2563EB" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppVersionText" Text="v1.0.0" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                    <Border Background="#059669" CornerRadius="4" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MIT LICENSE" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Interface Desktop (WPF) e Serviço Windows em .NET 10 para controle híbrido (RC API + CLI) do Rclone, com agendador de tarefas, telemetria em tempo real, otimizador de filtros e trava de release."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,4"/>
                <TextBlock Text="Copyright © 2026 Dillemon Recla" FontSize="11.5" Foreground="#38BDF8"/>
            </StackPanel>
        </Border>

        <!-- AMBIENTE EM EXECUÇÃO -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="AMBIENTE EM EXECUÇÃO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                <TextBlock x:Name="RuntimeInfoText" Text="Runtime: .NET 10" FontSize="12" Margin="0,0,0,3"/>
                <TextBlock x:Name="OsInfoText" Text="Sistema: Windows" FontSize="12" Margin="0,0,0,3"/>
                <TextBlock x:Name="RcloneInfoText" Text="Rclone: verificando..." FontSize="12" Foreground="#38BDF8"/>
            </StackPanel>
        </Border>

        <!-- PACOTES, FRAMEWORKS E TECNOLOGIAS -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="PACOTES, FRAMEWORKS &amp; COMPONENTES UTILIZADOS" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Rclone (rclone.exe) — Licença MIT" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="Motor de sincronização e armazenamento em nuvem (downloads.rclone.org). Integrado via linha de comando (CLI) e API HTTP Remote Control (rclone rcd / --rc) com verificação SHA-256."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text=".NET 10 SDK &amp; BCL (Microsoft.NETCore.App) — Licença MIT" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="Bibliotecas nativas System.Text.Json, System.Net.Http, System.IO.Compression.ZipFile, System.Security.Cryptography.SHA256 e Microsoft.Win32.Registry."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="ASP.NET Core (Microsoft.AspNetCore.App) — Licença MIT" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="Servidor Kestrel local (127.0.0.1:5580), Minimal APIs e BackgroundService do RcloneManager.Service para o agendador em segundo plano."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="WPF &amp; Windows Forms (Microsoft.WindowsDesktop.App) — Licença MIT" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="Interface gráfica WPF (Dark UI) com suporte a NotifyIcon (Bandeja do Sistema), System.Drawing e diálogos nativos do Windows."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Win32 API Nativa (advapi32.dll / user32.dll)" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="P/Invoke direto no WindowsServiceHost (StartServiceCtrlDispatcherW, RegisterServiceCtrlHandlerExW, SetServiceStatus) para rodar como Serviço Windows via sc.exe sem pacotes externos."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0B1220" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="10">
                            <TextBlock Text="Zero pacotes NuGet de terceiros: toda a solução compila offline apenas com os frameworks oficiais do .NET 10."
                                       Foreground="#10B981" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- APOIE O PROJETO -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="4" Padding="4" Width="96" Height="96" Margin="0,0,14,0">
                    <Image Source="pack://application:,,,/Assets/pix-qrcode.png" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="APOIE O PROJETO (OPEN SOURCE)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Chave Pix (Aleatória):" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="95b9aa86-3c99-421d-9c86-6a47a3b09d7b" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,2,0,8"/>
                    <WrapPanel VerticalAlignment="Center">
                        <Button x:Name="CopyPixButton" Content="Copiar Chave Pix" Style="{StaticResource SuccessButtonStyle}"
                                Click="CopyPixButton_Click" Padding="10,5" Margin="0,0,8,0"/>
                        <Button x:Name="OpenSponsorsButton" Content="GitHub Sponsors" Style="{StaticResource PrimaryButtonStyle}"
                                Click="OpenSponsorsButton_Click" Padding="10,5" Margin="0,0,10,0"/>
                        <TextBlock x:Name="CopiedPixText" Text="" FontSize="11.5" Foreground="#10B981" VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RODAPÉ -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="OpenLicenseButton" Content="Ver Licença (MIT)" Click="OpenLicenseButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="OpenGitHubButton" Content="Repositório GitHub" Click="OpenGitHubButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="OpenRcloneSiteButton" Content="Site do Rclone" Click="OpenRcloneSiteButton_Click"/>
            </StackPanel>
            <Button Content="Fechar" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"
                    Width="95" IsCancel="True" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
