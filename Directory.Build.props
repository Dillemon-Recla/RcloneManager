<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Authors>Dillemon Recla</Authors>
    <Company>Dillemon Recla</Company>
    <Product>RcloneManager</Product>
    <Description>Desktop GUI (WPF) and Background Scheduler Service (.NET 10) for Rclone on Windows.</Description>
    <Copyright>Copyright (c) 2026 Dillemon Recla</Copyright>
    <RepositoryUrl>https://github.com/Dillemon-Recla/RcloneManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
